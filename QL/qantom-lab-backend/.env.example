# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB Atlas ----
# Get this from Atlas: Database > Connect > Drivers > Node.js
# Replace <username>, <password>, <cluster-url> and keep the database name (qantomlab)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/qantomlab?retryWrites=true&w=majority

# ---- Sessions ----
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Admin login for /admin ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ---- CORS ----
# Comma-separated list of origins allowed to call the API with credentials.
# Leave as-is if the frontend is served by this same Express app (default setup).
CLIENT_ORIGIN=http://localhost:5000
